# Só para desenvolvimento local (npm run dev) com o backend ao vivo.
# Vazio = modo estático (produção no GitHub Pages): o painel lê /dados/*.json,
# gerados pelo GitHub Actions (ais-service/gerar_estatico.py).
# Nunca coloque chave aqui: tudo que começa com NEXT_PUBLIC_ vai para o navegador.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Estilo do mapa (MapLibre). Vazio = OpenFreeMap Positron
# (https://tiles.openfreemap.org/styles/positron, gratuito, sem chave).
NEXT_PUBLIC_MAPA_ESTILO_URL=
