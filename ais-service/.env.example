# Copie para .env e preencha. Nunca publique o .env real.
# No Render, estes valores vão em Environment (render.yaml lista os nomes).

# Chave gratuita do AISstream (https://aisstream.io). Um coletor por chave:
# outra conexão com a mesma chave é recusada (429).
AISSTREAM_API_KEY=

# Caixas do AIS em JSON: [[[lat_min, lon_min], [lat_max, lon_max]], ...]
# Vazio = costa do Brasil, Argentina, Uruguai e hidrovia Paraguai-Paraná.
AIS_CAIXAS=

# No máximo 1 posição por navio a cada N segundos no banco (padrão 60).
AIS_INTERVALO_GRAVACAO_S=

# Só em desenvolvimento (painel em :3000, API em :8000). Em produção o painel
# vem da mesma URL: deixe vazio.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Limites por IP por minuto: consultas à API e arquivos do painel.
LIMITE_REQ_POR_MIN=120
LIMITE_ARQUIVOS_POR_MIN=600

# 1 = usar o IP do X-Forwarded-For (atrás de proxy, como no Render).
CONFIAR_X_FORWARDED_FOR=0

# Calculadora de calado: desligada até existir, por porto, a profundidade do
# canal referida ao Nível de Redução (NR).
CALCULADORA_CALADO_ATIVA=0

# Litestream (backup contínuo do banco). Vazio = sem backup.
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
